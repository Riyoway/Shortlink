{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/forbidden"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/:slug",
      "destination": "/api/r/:slug"
    }
  ]
}
